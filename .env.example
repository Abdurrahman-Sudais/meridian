# Copy to .env for local dev (npm run dev). On Vercel, add these in
# Project → Settings → Environment Variables. NEVER commit real keys.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# server-only secret — never put in front-end code
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (Settings → API Keys & Webhooks) — start with TEST keys ---
PAYSTACK_SECRET_KEY=sk_test_xxx

# --- Store settings ---
# NGN | GHS | ZAR | KES | USD (USD needs Paystack approval)
STORE_CURRENCY=NGN
# site prices are in USD; this converts them at checkout. Update as rates move.
USD_TO_CURRENCY=1500
FREE_SHIPPING_OVER_USD=1000
SHIPPING_FLAT_USD=35
# used for Paystack's redirect back to your site
SITE_URL=https://your-domain.com

# --- Order emails (optional, https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=MERIDIAN <orders@your-domain.com>
# gets a copy of every order
ORDER_NOTIFY_EMAIL=you@your-domain.com
